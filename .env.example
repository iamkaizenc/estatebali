# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# JWT Secret (Required for authentication)
# Generate a strong random secret with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Email Service (Optional - Choose one)
# Resend
RESEND_API_KEY=your_resend_api_key_here

# OR SendGrid
# SENDGRID_API_KEY=your_sendgrid_api_key_here

# From Email Address (Required if using email service)
FROM_EMAIL=noreply@yourdomain.com

# Admin Email (Required for admin notifications)
ADMIN_EMAIL=admin@yourdomain.com

# Redis - Distributed Rate Limiting (Optional but Recommended for Production)
# Get free Redis instance at: https://console.upstash.com/
# If not set, falls back to in-memory rate limiting (single instance only)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Error Tracking (Optional)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Node Environment
NODE_ENV=development
